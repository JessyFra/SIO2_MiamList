<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="12dp"
    android:paddingBottom="36dp">

    <!-- Poignée de glissement -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="#E0E0E0" />

    <!-- En-tête -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="28dp">

        <!-- Icône accent -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_pill"
            android:layout_marginEnd="14dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="+"
                android:textSize="20sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ajouter un produit"
                android:textSize="17sp"
                android:fontFamily="sans-serif-light"
                android:textColor="#1A1A1A"
                android:letterSpacing="0.01" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Renseignez les informations du produit"
                android:textSize="11sp"
                android:fontFamily="sans-serif-light"
                android:textColor="#AAAAAA"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Champ : Libellé (obligatoire) -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nom du produit *"
        android:layout_marginBottom="16dp"
        style="@style/Widget.MiamList.TextInputLayout">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MiamList.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface"
            android:hint="Nom du produit">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/editProductLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="@color/on_surface"
                android:dropDownSelector="@color/accent_light"
                android:popupBackground="@color/background" />
        </com.google.android.material.textfield.TextInputLayout>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Ligne : Quantité + Unité -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="28dp">

        <!-- Quantité -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Quantité"
            android:layout_marginEnd="8dp"
            style="@style/Widget.MiamList.TextInputLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editProductQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:imeOptions="actionNext"
                android:fontFamily="sans-serif-light"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Unité -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Unité (ex: kg, L…)"
            style="@style/Widget.MiamList.TextInputLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editProductUnit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:fontFamily="sans-serif-light"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <!-- Boutons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelProduct"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Annuler"
            android:textColor="#CE7E4D"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.04"
            android:layout_marginEnd="8dp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:strokeColor="#CE7E4D"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveProduct"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Enregistrer"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.04"
            style="@style/Widget.MiamList.Button"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>
