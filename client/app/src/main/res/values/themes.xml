<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.MiamList" parent="Theme.Material3.Light.NoActionBar">
        <!-- Couleur primaire = accent terracotta -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_light</item>
        <item name="colorOnPrimaryContainer">@color/on_surface</item>

        <!-- Surface -->
        <item name="colorSurface">@color/background</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>

        <!-- Outline -->
        <item name="colorOutline">@color/outline</item>

        <!-- Typographie épurée -->
        <item name="android:fontFamily">sans-serif-light</item>

        <!-- Elevation zéro par défaut pour un look flat -->
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="Theme.MiamList" parent="Base.Theme.MiamList" />

    <!-- BottomSheet transparent pour que bg_bottom_sheet s'applique -->
    <style name="Theme.MiamList.BottomSheet" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.MiamList.BottomSheet</item>
    </style>

    <style name="Widget.MiamList.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <!-- Style bouton primaire plein -->
    <style name="Widget.MiamList.Button" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">4dp</item>
    </style>

    <!-- Style TextInputLayout minimaliste -->
    <style name="Widget.MiamList.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/outline</item>
        <item name="hintTextColor">@color/on_surface_secondary</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.MiamList.SmallComponent</item>
    </style>

    <style name="ShapeAppearance.MiamList.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">4dp</item>
    </style>

    <!-- Toolbar épurée -->
    <style name="Widget.MiamList.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/background</item>
        <item name="android:elevation">0dp</item>
        <item name="titleTextAppearance">@style/TextAppearance.MiamList.Toolbar</item>
    </style>

    <style name="TextAppearance.MiamList.Toolbar" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

</resources>